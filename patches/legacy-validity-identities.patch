 /* Identify returns the gallery print the match belongs to */
+static void
+test_legacy_binary_subtype_match (void)
+{
+  g_autoptr(FpDevice) device = g_object_new (FPI_TYPE_DEVICE_FAKE, NULL);
+  g_autoptr(FpPrint) print = make_enrolled_print (device, FP_FINGER_UNKNOWN, NULL);
+  const guint16 subtypes[] = { 245, 246 };
+  const guint8 sid[] = { 1, 1, 0, 0, 0, 0, 0, 5, 18, 0, 0, 0 };
+  ValidityUser user;
+  ValidityMatchResult match;
+  make_user_record (&user, 9, "placeholder", subtypes, 2);
+  g_free (user.identity);
+  user.identity_len = 8 + sizeof (sid);
+  user.identity = g_malloc0 (user.identity_len);
+  user.identity[0] = 3;
+  user.identity[4] = sizeof (sid);
+  memcpy (user.identity + 8, sid, sizeof (sid));
+  g_object_set (print, "fpi-data",
+                g_variant_new ("(q@ay)", 245,
+                  g_variant_new_fixed_array (G_VARIANT_TYPE_BYTE, sid, sizeof (sid), 1)),
+                NULL);
+  make_match (&match, 9, FP_FINGER_UNKNOWN);
+  match.subtype = 245;
+  g_assert_true (validity_print_matches_record (print, &match, &user));
+  match.subtype = 246;
+  g_assert_false (validity_print_matches_record (print, &match, &user));
+  match.subtype = 245;
+  match.user_dbid = 18;
+  g_assert_false (validity_print_matches_record (print, &match, &user));
+  match.user_dbid = 9;
+  user.identity[8] ^= 1;
+  g_assert_false (validity_print_matches_record (print, &match, &user));
+  validity_user_clear (&user);
+}
+
 static void
 test_gallery_match_correlates (void)
 {
@@ -6923,6 +6957,7 @@ main (int argc, char *argv[])
                    test_gallery_match_empty);
   g_test_add_func ("/validity/verify/user_get_id",
                    test_user_get_id);
